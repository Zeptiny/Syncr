# Secrets for deploy/docker-compose.yml. Copy to deploy/.env (next to the
# compose file, where `docker compose` reads it), fill in, and keep it
# private: chmod 600 deploy/.env.

# Postgres password. Use URL-safe characters (it goes into a connection URL):
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# Encrypts the credentials of remotes and workers at rest: 32 random bytes
# in base64. Back it up; without it, stored secrets cannot be read.
#   openssl rand -base64 32
SYNCR_SECRETS_KEY=

# The URL browsers and workers reach the controller at, behind a
# TLS-terminating reverse proxy, e.g. https://syncr.example.com. It goes into
# the worker install commands and makes the session cookie Secure. Leave it
# empty to use the browser's address.
SYNCR_PUBLIC_URL=

# Optional.
# SYNCR_PUBLISH=127.0.0.1:8080        # host address:port to publish the controller on
# SYNCR_LOG_FORMAT=text
# SYNCR_WORKER_TOKEN=                 # enrollment token for the optional compose worker
# SYNCR_SETUP_CODE=                   # preset first-run setup code (16+ characters; case, dashes and spaces are ignored) instead of a random one

# Notifications (optional). The default policy lets notification targets be
# on the LAN but never loopback, link-local or cloud metadata addresses.
# SYNCR_NOTIFY_NETWORK_POLICY=private  # private | public (no private networks either) | any
# SYNCR_NOTIFY_ALLOWED_NETWORKS=       # CIDRs or IPs allowed anyway, comma-separated, e.g. 172.17.0.1
# Message links use SYNCR_PUBLIC_URL; without it, notifications carry no link.
