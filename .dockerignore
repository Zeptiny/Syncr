# Keep the build context small and free of local artifacts/secrets.
.git
bin
dist
# The controller image builds the web UI from web/ (package*.json, src,
# public, configs); only local installs and builds stay out.
web/node_modules
web/dist
**/*.test
**/*.out
# Local env files hold secrets (setup code, DB password, keyring key) and
# must stay out of the context at any depth, e.g. deploy/.env. The
# committed .env.example templates are kept.
**/.env
**/.env.*
!**/.env.example
*.local.yaml
*.local.yml
deploy/*.yml
